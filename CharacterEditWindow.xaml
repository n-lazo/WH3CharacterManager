<Window x:Class="WH3CharacterManager.CharacterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Personaje - Warhammer 3" Height="580" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource AppBgBrush}"
        BorderBrush="{StaticResource BorderSubtleBrush}"
        BorderThickness="1"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra de Título -->
            <RowDefinition Height="*"/>    <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Barra de Título Personalizada -->
        <Grid Grid.Row="0" Height="36" Background="#0A0D14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Path Data="{StaticResource IconEditGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="EDITAR PERSONAJE" FontSize="11" FontWeight="Bold" 
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource TitleBarCloseButtonStyle}" 
                    Click="BtnCancel_Click" ToolTip="Cerrar" WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="{StaticResource IconCloseGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                      Width="10" Height="10" Stretch="Uniform"/>
            </Button>
        </Grid>

        <!-- Contenedor Principal de la Ventana -->
        <Border Grid.Row="1" Margin="14,2,14,14" Background="{StaticResource SurfaceCardBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource HeaderGlowGradient}"/>
                <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Encabezado -->
                    <RowDefinition Height="Auto"/> <!-- Resumen Héroe -->
                    <RowDefinition Height="*"/>    <!-- Campos de edición -->
                    <RowDefinition Height="Auto"/> <!-- Opciones (Backup) -->
                    <RowDefinition Height="Auto"/> <!-- Botones de acción -->
                </Grid.RowDefinitions>

                <!-- 1. Encabezado -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="MODIFICAR NOMBRES Y ETIQUETA" FontWeight="Bold" FontSize="15" 
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Actualiza directamente el archivo .twc sin alterar atributos ni habilidades" 
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 2. Tarjeta Resumen del Personaje -->
                <Border Grid.Row="1" Margin="0,0,0,14" Background="{StaticResource SurfaceInputBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Marco de Retrato -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="#142338" 
                                BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="1" Margin="0,0,12,0"
                                ClipToBounds="True" VerticalAlignment="Center">
                            <Grid>
                                <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanLightBrush}" 
                                      Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ImgCharacterPortrait" Stretch="UniformToFill" 
                                       RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LblCharacterHeaderName" FontSize="14" FontWeight="Bold" 
                                       Foreground="{StaticResource CyanNeonBrush}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Image x:Name="ImgRaceIcon" Width="14" Height="14" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="LblCharacterSubInfo" FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Campos de Edición -->
                <StackPanel Grid.Row="2">
                    <!-- Nombre de Pila (Forename) -->
                    <TextBlock Text="NOMBRE DEL PERSONAJE (FORENAME):" FontSize="10.5" FontWeight="Bold" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtForename" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Primer nombre del héroe (ej. Jorge, Eltharion, Tyrion)" FontSize="10" 
                               Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,10"/>

                    <!-- Apellido (Surname) -->
                    <TextBlock Text="APELLIDO DEL PERSONAJE (SURNAME, OPCIONAL):" FontSize="10.5" FontWeight="Bold" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSurname" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Apellido o título secundario (ej. Nitales, Sombrío). Dejar vacío si no aplica." FontSize="10" 
                               Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,10"/>

                    <!-- Etiqueta de Guardado (Saved Tag) -->
                    <TextBlock Text="ETIQUETA DE GUARDADO (SAVED TAG):" FontSize="10.5" FontWeight="Bold" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSavedTag" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Identificador visible en la lista de guardados dentro de Warhammer 3" FontSize="10" 
                               Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,10"/>
                </StackPanel>

                <!-- 4. Opción de Respaldo -->
                <Border Grid.Row="3" Margin="0,4,0,12" Background="#0C1420" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="7" Padding="12,10">
                    <CheckBox x:Name="ChkCreateBackup" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" VerticalAlignment="Center">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Crear copia de respaldo (.bak) antes de guardar" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Permite restaurar el archivo original si surge cualquier incompatibilidad" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- 5. Botones de Acción -->
                <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnCancel" Grid.Column="1" Content="CANCELAR" Width="110" Height="38" 
                            Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>

                    <Button x:Name="BtnSave" Grid.Column="2" Width="160" Height="38" 
                            Style="{StaticResource PrimaryButtonStyle}" Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheckGeometry}" Fill="White" 
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="GUARDAR CAMBIOS" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
