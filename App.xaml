<Application x:Class="WH3CharacterManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta de Colores Warhammer Modern Gaming Dark -->
            <Color x:Key="AppBgColor">#0A0D14</Color>
            <Color x:Key="SurfaceCardColor">#131824</Color>
            <Color x:Key="SurfaceCardHoverColor">#1A2232</Color>
            <Color x:Key="SurfaceInputColor">#0E131E</Color>
            <Color x:Key="BorderSubtleColor">#222B3D</Color>
            <Color x:Key="BorderFocusColor">#00D2FF</Color>

            <Color x:Key="CyanNeonColor">#00D2FF</Color>
            <Color x:Key="CyanLightColor">#70E3FF</Color>
            <Color x:Key="BluePrimaryColor">#0284C7</Color>
            <Color x:Key="BlueDarkColor">#071A33</Color>

            <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
            <Color x:Key="TextSecondaryColor">#94A3B8</Color>
            <Color x:Key="TextMutedColor">#64748B</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}"/>
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}"/>
            <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHoverColor}"/>
            <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

            <SolidColorBrush x:Key="CyanNeonBrush" Color="{StaticResource CyanNeonColor}"/>
            <SolidColorBrush x:Key="CyanLightBrush" Color="{StaticResource CyanLightColor}"/>
            <SolidColorBrush x:Key="BluePrimaryBrush" Color="{StaticResource BluePrimaryColor}"/>
            <SolidColorBrush x:Key="BlueDarkBrush" Color="{StaticResource BlueDarkColor}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

            <!-- Brushes de compatibilidad -->
            <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource CyanNeonColor}"/>
            <SolidColorBrush x:Key="DarkBrush" Color="{StaticResource AppBgColor}"/>
            <SolidColorBrush x:Key="LightBlueBrush" Color="{StaticResource CyanLightColor}"/>
            <SolidColorBrush x:Key="DarkBlueBrush" Color="{StaticResource SurfaceCardColor}"/>
            <SolidColorBrush x:Key="DarkGrayBrush" Color="{StaticResource SurfaceInputColor}"/>
            <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}"/>

            <!-- Gradientes Premium -->
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0284C7" Offset="0.0"/>
                <GradientStop Color="#00D2FF" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0369A1" Offset="0.0"/>
                <GradientStop Color="#38BDF8" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeaderGlowGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00D2FF" Offset="0.0"/>
                <GradientStop Color="#3B82F6" Offset="0.5"/>
                <GradientStop Color="#8B5CF6" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Vector Geometries (Iconos) -->
            <Geometry x:Key="IconFolderGeometry">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</Geometry>
            <Geometry x:Key="IconScanGeometry">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</Geometry>
            <Geometry x:Key="IconSearchGeometry">M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</Geometry>
            <Geometry x:Key="IconCopyGeometry">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</Geometry>
            <Geometry x:Key="IconExportGeometry">M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2v9.67z</Geometry>
            <Geometry x:Key="IconExternalGeometry">M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z</Geometry>
            <Geometry x:Key="IconHeroGeometry">M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z</Geometry>
            <Geometry x:Key="IconCloseGeometry">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</Geometry>

            <!-- Botón Principal Premium (Glow + Gradient) -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="shadow" ShadowDepth="0" Color="#00D2FF" Opacity="0.3" BlurRadius="10"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentGradientHoverBrush}"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" Color="#00D2FF" Opacity="0.65" BlurRadius="16"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BlueDarkBrush}"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" Color="#00D2FF" Opacity="0.2" BlurRadius="6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón Secundario (Dark Card + Stroke) -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón Estilo Gaming Legacy (mapeado a PrimaryButtonStyle) -->
            <Style x:Key="GamingButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button"/>

            <!-- TextBox Moderno -->
            <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CaretBrush" Value="{StaticResource CyanNeonBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3B4863"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" Color="#00D2FF" Opacity="0.25" BlurRadius="8"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GamingTextBoxStyle" BasedOn="{StaticResource ModernTextBoxStyle}" TargetType="TextBox"/>

            <!-- ListView Moderno -->
            <Style x:Key="ModernListViewStyle" TargetType="ListView">
                <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListView">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8" SnapsToDevicePixels="True">
                                <ScrollViewer Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GamingListViewStyle" BasedOn="{StaticResource ModernListViewStyle}" TargetType="ListView"/>

            <!-- RadioButton Moderno -->
            <Style x:Key="ModernRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="cardBorder" Background="{StaticResource SurfaceInputBrush}" 
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                                    CornerRadius="6" Padding="12,10" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="outerCircle" Width="18" Height="18" CornerRadius="9"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1.5" 
                                            Background="Transparent" VerticalAlignment="Center">
                                        <Ellipse x:Name="innerDot" Width="8" Height="8" 
                                                 Fill="{StaticResource CyanNeonBrush}" Opacity="0" 
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ContentPresenter Grid.Column="1" Margin="10,0,0,0" 
                                                      VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="innerDot" Property="Opacity" Value="1"/>
                                    <Setter TargetName="outerCircle" Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                    <Setter TargetName="cardBorder" Property="Background" Value="#172235"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource CyanLightBrush}"/>
                                    <Setter TargetName="outerCircle" Property="BorderBrush" Value="{StaticResource CyanLightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GamingRadioButtonStyle" BasedOn="{StaticResource ModernRadioButtonStyle}" TargetType="RadioButton"/>

            <!-- ProgressBar Moderno -->
            <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentGradientBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="7" SnapsToDevicePixels="True"/>
                                <Border x:Name="PART_Indicator" 
                                        Background="{TemplateBinding Foreground}" 
                                        HorizontalAlignment="Left" 
                                        CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" Color="#00D2FF" Opacity="0.5" BlurRadius="8"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GamingProgressBarStyle" BasedOn="{StaticResource ModernProgressBarStyle}" TargetType="ProgressBar"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
