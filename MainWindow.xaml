<Window x:Class="WH3CharacterManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warhammer 3 Character Manager" Height="740" Width="1140"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Background="{StaticResource AppBgBrush}"
        BorderBrush="{StaticResource BorderSubtleBrush}"
        BorderThickness="1"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Menú Contextual Compartido para Personajes (Tabla y Galería) -->
        <ContextMenu x:Key="CharacterContextMenu" Style="{StaticResource ModernContextMenuStyle}">
            <MenuItem Header="Duplicar personaje..." Click="CtxDuplicate_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCopyGeometry}" Fill="{StaticResource CyanNeonBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Exportar copia (.twc)..." Click="CtxExport_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconExportGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource ModernSeparatorStyle}"/>
            <MenuItem Header="Mostrar en Explorador de Windows" Click="CtxShowInExplorer_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFolderGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copiar nombre de personaje" Click="CtxCopyName_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCopyGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource ModernSeparatorStyle}"/>
            <MenuItem Header="Eliminar personaje..." Click="CtxDeleteCharacter_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconDeleteGeometry}" Fill="#F87171" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra de Título Personalizada -->
            <RowDefinition Height="*"/>    <!-- Contenedor Principal de la App -->
        </Grid.RowDefinitions>

        <!-- 0. BARRA DE TÍTULO PERSONALIZADA (WINDOW CHROME) -->
        <Grid Grid.Row="0" Height="38" Background="#0A0D14" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo y Título -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="WARHAMMER 3" FontSize="11" FontWeight="Bold" 
                           Foreground="{StaticResource CyanNeonBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="CHARACTER MANAGER" FontSize="11" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Espacio para arrastrar la ventana -->
            <Border Grid.Column="1" Background="Transparent"/>

            <!-- Botones de Control de Ventana -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimizar">
                    <Path Data="{StaticResource IconMinimizeGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click" ToolTip="Maximizar / Restaurar">
                    <Path x:Name="IconMaximizePath" Data="{StaticResource IconMaximizeGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" ToolTip="Cerrar">
                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- CONTENIDO PRINCIPAL DE LA APP -->
        <Grid Grid.Row="1" Margin="16,4,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Encabezado -->
                <RowDefinition Height="Auto"/> <!-- Barra de carpeta, búsqueda y switcher -->
                <RowDefinition Height="*"/>    <!-- Contenido principal (Lista/Galería + Sidebar) -->
                <RowDefinition Height="Auto"/> <!-- Barra de estado -->
            </Grid.RowDefinitions>

            <!-- 1. ENCABEZADO -->
            <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,12" 
                    Background="{StaticResource SurfaceCardBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icono de escudo / héroe -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" 
                            Background="#102138" BorderBrush="{StaticResource CyanNeonBrush}" 
                            BorderThickness="1" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Título y subtítulo -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL WAR: WARHAMMER III" FontSize="11" FontWeight="Bold" 
                                   Foreground="{StaticResource CyanNeonBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="Character Manager" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Badges y botón de acceso rápido -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Contador de personajes -->
                        <Border Background="#102138" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource CyanNeonBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtCharacterCountBadge" Text="0 Personajes" 
                                           FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Botón para abrir carpeta en el explorador de Windows -->
                        <Button x:Name="BtnOpenFolderInExplorer" Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="12,6" Click="BtnOpenFolderInExplorer_Click" ToolTip="Abrir esta carpeta en el Explorador de Windows">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExternalGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Abrir Carpeta" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. BARRA DE CARPETA, BÚSQUEDA Y MODO DE VISTA -->
            <Border Grid.Row="1" Margin="0,0,0,14" Padding="14" 
                    Background="{StaticResource SurfaceCardBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selector de Carpeta -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="CARPETA:" VerticalAlignment="Center" 
                                   FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>

                        <TextBox x:Name="TxtFolderPath" Grid.Column="1" Margin="0,0,10,0" 
                                 Style="{StaticResource ModernTextBoxStyle}"/>

                        <Button x:Name="BtnBrowseFolder" Grid.Column="2" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseFolder_Click"
                                ToolTip="Seleccionar otra carpeta">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolderGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Examinar"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnScanFolder" Grid.Column="3"
                                Style="{StaticResource PrimaryButtonStyle}" Click="BtnScanFolder_Click"
                                ToolTip="Volver a escanear personajes en la carpeta (F5)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconScanGeometry}" Fill="White" 
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Escanear"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Barra de Búsqueda y Switcher de Vista -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="FILTRAR:" VerticalAlignment="Center" 
                                   FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>

                        <Grid Grid.Column="1" Margin="0,0,10,0">
                            <TextBox x:Name="TxtSearchFilter" Style="{StaticResource ModernTextBoxStyle}" 
                                     TextChanged="TxtSearchFilter_TextChanged"/>
                            <!-- Placeholder cuando está vacío -->
                            <TextBlock Text="Buscar por nombre, clase, raza o rasgo (ej. Glade Captain, Elfos, Kurnous)..." 
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchFilter}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Botón limpiar búsqueda -->
                            <Button x:Name="BtnClearSearch" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                    Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="BtnClearSearch_Click" Visibility="Collapsed" ToolTip="Limpiar búsqueda (Esc)">
                                <Path Data="{StaticResource IconCloseGeometry}" Fill="{StaticResource TextMutedBrush}" 
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="TxtFilterStatus" Grid.Column="2" VerticalAlignment="Center" 
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,14,0"/>

                        <!-- Switcher de Modo de Vista [ Tabla | Galería ] -->
                        <Border Grid.Column="3" Background="#0C131F" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbViewTable" Style="{StaticResource ViewToggleButtonStyle}" 
                                             GroupName="ViewMode" IsChecked="True" Click="ViewToggle_Click" ToolTip="Vista Tabla detallada">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTableGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tabla" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbViewGallery" Style="{StaticResource ViewToggleButtonStyle}" 
                                             GroupName="ViewMode" Click="ViewToggle_Click" ToolTip="Vista Galería de retratos de héroes">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGalleryGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Galería" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. LISTA / GALERÍA DE PERSONAJES Y PANEL LATERAL -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- Área Principal: Tabla o Galería -->
                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <!-- Vista 1: Tabla ListView -->
                    <ListView x:Name="LvCharacters" 
                              Style="{StaticResource ModernListViewStyle}"
                              SelectionChanged="LvCharacters_SelectionChanged"
                              MouseDoubleClick="LvCharacters_MouseDoubleClick">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="#0E131D"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Margin" Value="2,2,2,2"/>
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ContextMenu" Value="{StaticResource CharacterContextMenu}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewMouseRightButtonDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <GridViewRowPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#10253F"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <!-- Columna: Personaje -->
                                <GridViewColumn Header="PERSONAJE" Width="210">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="6" Background="#162234" 
                                                        BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="0.8"
                                                        Margin="0,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Grid>
                                                        <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanLightBrush}" 
                                                              Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding PortraitImagePath}" Stretch="UniformToFill" 
                                                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" 
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="155"/>
                                                    <TextBlock Text="{Binding FileName}" FontSize="9.5" 
                                                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Clase -->
                                <GridViewColumn Header="CLASE / HÉROE" Width="175">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding HeroClassDisplay}" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource CyanNeonBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Raza -->
                                <GridViewColumn Header="RAZA" Width="125">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#141D2D" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                                    BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{Binding RaceIconPath}" Width="16" Height="16" Margin="0,0,5,0" 
                                                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RaceDisplay}" FontSize="11" 
                                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Nivel -->
                                <GridViewColumn Header="NIVEL" Width="65">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#14261C" BorderBrush="#059669" 
                                                    BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding LevelDisplay}" FontSize="11" FontWeight="Bold" 
                                                           Foreground="#34D399"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Rasgo -->
                                <GridViewColumn Header="RASGO INNATO" Width="135">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TraitDisplay}" FontSize="11" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Tamaño -->
                                <GridViewColumn Header="TAMAÑO" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedFileSize}" FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Modificado -->
                                <GridViewColumn Header="MODIFICADO" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedLastModified}" FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Vista 2: Galería de Tarjetas Visuales (Roster Cards) -->
                    <ListBox x:Name="LbGallery" 
                             Style="{StaticResource ModernListBoxStyle}"
                             SelectionChanged="LbGallery_SelectionChanged"
                             MouseDoubleClick="LbGallery_MouseDoubleClick"
                             Visibility="Collapsed">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ContextMenu" Value="{StaticResource CharacterContextMenu}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewMouseRightButtonDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="cardBorder" 
                                                    Width="192" Height="255"
                                                    Background="{StaticResource SurfaceCardBrush}" 
                                                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                                                    BorderThickness="1.2" 
                                                    CornerRadius="8" 
                                                    SnapsToDevicePixels="True"
                                                    ClipToBounds="True">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="cardShadow" ShadowDepth="2" BlurRadius="8" Opacity="0.3" Color="#000000"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="140"/> <!-- Imagen de Retrato -->
                                                        <RowDefinition Height="*"/>   <!-- Datos del Personaje -->
                                                    </Grid.RowDefinitions>

                                                    <!-- 1. ZONA RETRATO -->
                                                    <Border Grid.Row="0" Background="#0C131F" ClipToBounds="True">
                                                        <Grid>
                                                            <!-- Placeholder de fondo si no hay retrato -->
                                                            <Path Data="{StaticResource IconHeroGeometry}" Fill="#1A2D45" 
                                                                  Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                            <!-- Retrato oficial -->
                                                            <Image Source="{Binding PortraitImagePath}" Stretch="UniformToFill" 
                                                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                            <!-- Gradiente inferior suave -->
                                                            <Border VerticalAlignment="Bottom" Height="32">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                                        <GradientStop Color="#E6131824" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <!-- Badge de Raza (Arriba Izquierda) -->
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                                    Margin="6" CornerRadius="4" Padding="4,2"
                                                                    Background="#D90E1624" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0.8">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Image Source="{Binding RaceIconPath}" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <TextBlock Text="{Binding RaceDisplay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Badge de Nivel (Arriba Derecha) -->
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                                    Margin="6" CornerRadius="4" Padding="5,2"
                                                                    Background="#D914261C" BorderBrush="#059669" BorderThickness="0.8">
                                                                <TextBlock Text="{Binding LevelDisplay}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 2. ZONA DATOS -->
                                                    <StackPanel Grid.Row="1" Margin="10,8,10,8" VerticalAlignment="Center">
                                                        <!-- Nombre Principal -->
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" 
                                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>

                                                        <!-- Clase de héroe -->
                                                        <TextBlock Text="{Binding HeroClassDisplay}" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="{StaticResource CyanNeonBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                                        <!-- Rasgo innato (en pill pequeña) -->
                                                        <Border HorizontalAlignment="Left" Background="#0C1522" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                                                BorderThickness="0.8" CornerRadius="3" Padding="5,2">
                                                            <TextBlock Text="{Binding TraitDisplay}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" 
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource CyanLightBrush}"/>
                                                    <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                                                    <Setter TargetName="cardBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.3" Color="#00D2FF"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                                    <Setter TargetName="cardBorder" Property="BorderThickness" Value="1.8"/>
                                                    <Setter TargetName="cardBorder" Property="Background" Value="#10253F"/>
                                                    <Setter TargetName="cardBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="2" BlurRadius="16" Opacity="0.55" Color="#00D2FF"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Estado vacío (Empty State) -->
                    <Border x:Name="EmptyStateOverlay" Background="{StaticResource SurfaceCardBrush}" 
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                            CornerRadius="8" Visibility="Collapsed" Padding="30">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="60" Height="60" CornerRadius="30" Background="#111B29" 
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource TextMutedBrush}" 
                                      Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No se encontraron personajes" FontSize="16" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Verifica la ruta de guardado o pulsa 'Escanear' para cargar tus personajes." 
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Panel Lateral de Acciones y Ficha Detallada -->
                <StackPanel Grid.Column="1">
                    <!-- Tarjeta de Acciones -->
                    <Border Background="{StaticResource SurfaceCardBrush}" 
                            BorderBrush="{StaticResource BorderSubtleBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ACCIONES" FontSize="11" FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                            <!-- Botón Duplicar -->
                            <Button x:Name="BtnDuplicateCharacter" Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="44" Margin="0,0,0,10" Click="BtnDuplicateCharacter_Click"
                                    IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCopyGeometry}" Fill="White" 
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="DUPLICAR..." FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Botón Exportar -->
                            <Button x:Name="BtnExportCharacter" Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="38" Margin="0,0,0,8" Click="BtnExportCharacter_Click"
                                    IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExportGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Exportar copia (.twc)"/>
                                </StackPanel>
                            </Button>

                            <!-- Botón Eliminar -->
                            <Button x:Name="BtnDeleteCharacter" Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="34" Click="BtnDeleteCharacter_Click"
                                    IsEnabled="False" ToolTip="Eliminar este archivo de personaje">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDeleteGeometry}" Fill="#F87171" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Eliminar personaje..." Foreground="#F87171" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta de Ficha de Personaje -->
                    <Border Background="{StaticResource SurfaceCardBrush}" 
                            BorderBrush="{StaticResource BorderSubtleBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="FICHA DEL PERSONAJE" FontSize="11" FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                            <!-- Estado con personaje seleccionado -->
                            <StackPanel x:Name="CardSelectedInfo" Visibility="Collapsed">
                                <!-- Retrato y Nombre Principal -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Marco del Retrato -->
                                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" 
                                            Background="#121D2C" BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="1.2"
                                            Margin="0,0,10,0" VerticalAlignment="Top" ClipToBounds="True">
                                        <Grid>
                                            <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanLightBrush}" 
                                                  Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="ImgSelectedPortrait" Stretch="UniformToFill" 
                                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Nombre de campaña:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,1"/>
                                        <TextBlock x:Name="TxtSelectedName" Text="Magno Frochlichmann" FontSize="15" FontWeight="Bold" 
                                                   Foreground="{StaticResource CyanNeonBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtSelectedSavedTag" Text="Etiqueta: HawkShisho" FontSize="10.5" 
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,4"/>
                                        <Border Background="#14261C" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtSelectedLevel" Text="Nv. 2" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Clase -->
                                <TextBlock Text="Clase:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,1"/>
                                <TextBlock x:Name="TxtSelectedClass" Text="Glade Captain" FontSize="12.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Raza y Rasgo -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Raza:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="ImgSelectedRace" Width="18" Height="18" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="TxtSelectedRace" Text="Elfos Silvanos" FontSize="11.5" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Rasgo:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtSelectedTrait" Text="Weapon Master" FontSize="11.5" 
                                                   Foreground="{StaticResource CyanLightBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Habilidades con Badges Estilizados -->
                                <TextBlock Text="Habilidades aprendidas:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <ItemsControl x:Name="IcSelectedSkills" Margin="0,0,0,6" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#102035" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0.8" 
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource CyanLightBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtNoSkills" Text="Habilidades base de campaña" FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" Visibility="Visible"/>

                                <!-- Archivo con Botón de Localizar -->
                                <TextBlock Text="Archivo en disco:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,1"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtSelectedFileName" Text="a681...2827.twc" FontSize="10" 
                                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnOpenFileLocation" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="6,3" Margin="4,0,0,0" ToolTip="Mostrar archivo en el explorador" Click="BtnOpenFileLocation_Click">
                                        <Path Data="{StaticResource IconFolderGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- Tip interactivo -->
                                <Border Background="#102538" BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="0.8" 
                                        CornerRadius="4" Padding="8,6">
                                    <TextBlock Text="Doble clic para duplicar • Clic derecho para más opciones" FontSize="10.5" 
                                               Foreground="{StaticResource CyanLightBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Estado sin selección -->
                            <StackPanel x:Name="CardNoSelection">
                                <TextBlock Text="Selecciona un personaje de la lista o galería para ver su ficha completa y opciones." FontSize="12" 
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,20"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 4. BARRA DE ESTADO INFERIOR -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceCardBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                    CornerRadius="6" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource CyanNeonBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Listo" FontWeight="SemiBold" FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="WH3 Character Manager • .NET 9" FontSize="11" 
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- BANNER DE NOTIFICACIÓN FLOTANTE (TOAST) -->
        <Border x:Name="ToastNotification" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                Margin="0,0,0,24" Padding="16,10" CornerRadius="8"
                Background="#10253F" BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="1.2"
                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Color="#00D2FF" Opacity="0.45" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="ToastIcon" Data="{StaticResource IconCheckGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtToastMessage" Text="Acción realizada con éxito" FontWeight="SemiBold" FontSize="12.5" 
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>