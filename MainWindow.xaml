<Window x:Class="WH3CharacterManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warhammer 3 Character Manager" Height="760" Width="1180"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Background="{StaticResource AppBgBrush}"
        BorderBrush="#1E293B"
        BorderThickness="1"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Menú Contextual Compartido para Personajes (Tabla y Galería) -->
        <ContextMenu x:Key="CharacterContextMenu" Style="{StaticResource ModernContextMenuStyle}">
            <MenuItem Header="Duplicar personaje..." Click="CtxDuplicate_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCopyGeometry}" Fill="{StaticResource CyanNeonBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Editar personaje... (Ctrl+E)" Click="CtxEdit_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconEditGeometry}" Fill="{StaticResource CyanNeonBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Exportar copia (.twc)..." Click="CtxExport_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconExportGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource ModernSeparatorStyle}"/>
            <MenuItem Header="Mostrar en Explorador de Windows" Click="CtxShowInExplorer_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFolderGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copiar nombre de personaje" Click="CtxCopyName_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCopyGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource ModernSeparatorStyle}"/>
            <MenuItem Header="Eliminar personaje..." Click="CtxDeleteCharacter_Click" Style="{StaticResource ModernMenuItemStyle}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconDeleteGeometry}" Fill="#F87171" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra de Título Personalizada -->
            <RowDefinition Height="*"/>    <!-- Contenedor Principal de la App -->
        </Grid.RowDefinitions>

        <!-- 0. BARRA DE TÍTULO PERSONALIZADA (WINDOW CHROME) -->
        <Border Grid.Row="0" Height="38" Background="#070A10" BorderBrush="#151D2A" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo y Título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="#102238" BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="0.8" Margin="0,0,9,0">
                        <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                              Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="WARHAMMER III" FontSize="11" FontWeight="Bold" 
                               Foreground="{StaticResource CyanNeonBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CHARACTER MANAGER" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Espacio para arrastrar la ventana -->
                <Border Grid.Column="1" Background="Transparent"/>

                <!-- Botones de Control de Ventana -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimizar">
                        <Path Data="{StaticResource IconMinimizeGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click" ToolTip="Maximizar / Restaurar">
                        <Path x:Name="IconMaximizePath" Data="{StaticResource IconMaximizeGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" ToolTip="Cerrar">
                        <Path Data="{StaticResource IconCloseGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL DE LA APP -->
        <Grid Grid.Row="1" Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Encabezado Unificado + Ruta de Carpeta -->
                <RowDefinition Height="Auto"/> <!-- 2. Barra de Búsqueda, Filtros y Chips de Raza -->
                <RowDefinition Height="*"/>    <!-- 3. Contenido principal (Tabla/Galería + Inspector RPG) -->
                <RowDefinition Height="Auto"/> <!-- 4. Barra de estado -->
            </Grid.RowDefinitions>

            <!-- 1. ENCABEZADO PREMIUM COMPACTO CON SELECTOR DE CARPETA INTEGRADO -->
            <Border Grid.Row="0" Margin="0,0,0,10" 
                    Background="{StaticResource SurfaceCardBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2"/>    <!-- Línea de acento superior con gradiente -->
                        <RowDefinition Height="Auto"/> <!-- Contenido del encabezado -->
                    </Grid.RowDefinitions>

                    <!-- Barra luminosa superior -->
                    <Border Grid.Row="0" Background="{StaticResource HeaderGlowGradient}"/>

                    <Grid Grid.Row="1" Margin="14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Identidad y Contador -->
                            <ColumnDefinition Width="24"/>   <!-- Separador -->
                            <ColumnDefinition Width="*"/>    <!-- Selector de Carpeta Integrado -->
                        </Grid.ColumnDefinitions>

                        <!-- Identidad de la App + Badge de Total -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="9" 
                                    Background="#0F2138" BorderBrush="{StaticResource CyanNeonBrush}" 
                                    BorderThickness="1.2" Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00D2FF" Opacity="0.35"/>
                                </Border.Effect>
                                <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                                      Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL WAR: WARHAMMER III" FontSize="10" FontWeight="Bold" 
                                               Foreground="{StaticResource CyanNeonBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Cuartel de Personajes" FontSize="17" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Contador de personajes -->
                            <Border Background="#0E1C30" BorderBrush="#1E3A5F" 
                                    BorderThickness="1" CornerRadius="14" Padding="11,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource CyanNeonBrush}" Margin="0,0,7,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#00D2FF" Opacity="0.8"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="TxtCharacterCountBadge" Text="0 Personajes" 
                                               FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource CyanLightBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Divisor vertical sutil -->
                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4" HorizontalAlignment="Center"/>

                        <!-- Barra de Carpeta Integrada -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconFolderGeometry}" Fill="{StaticResource TextMutedBrush}" 
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RUTA:" VerticalAlignment="Center" FontWeight="Bold" FontSize="10.5" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBox x:Name="TxtFolderPath" Grid.Column="1" Margin="0,0,8,0" 
                                     FontSize="12" Padding="10,6"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     ToolTip="Ruta de la carpeta saved_characters de Total War: Warhammer III"/>

                            <Button x:Name="BtnBrowseFolder" Grid.Column="2" Margin="0,0,6,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Click="BtnBrowseFolder_Click"
                                    ToolTip="Seleccionar otra carpeta de personajes">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolderGeometry}" Fill="{StaticResource CyanLightBrush}" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Examinar" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnOpenFolderInExplorer" Grid.Column="3" Margin="0,0,6,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="9,6" 
                                    Click="BtnOpenFolderInExplorer_Click" ToolTip="Abrir carpeta actual en el Explorador de Windows">
                                <Path Data="{StaticResource IconExternalGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="BtnScanFolder" Grid.Column="4"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" Click="BtnScanFolder_Click"
                                    ToolTip="Escanear personajes en la carpeta (F5)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconScanGeometry}" Fill="White" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Escanear" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. BARRA DE BÚSQUEDA, FILTROS, ORDENAMIENTO Y CHIPS DE RAZAS -->
            <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,10" 
                    Background="{StaticResource SurfaceCardBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Fila 0: Buscador con icono, Rol, Orden y Switcher -->
                        <RowDefinition Height="Auto"/> <!-- Fila 1: Chips de Razas con Escudos -->
                    </Grid.RowDefinitions>

                    <!-- Barra de Búsqueda, Filtros de Rol, Orden y Switcher de Vista -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>    <!-- Search Box con Icono -->
                            <ColumnDefinition Width="Auto"/> <!-- Rol ComboBox -->
                            <ColumnDefinition Width="Auto"/> <!-- Orden Selector -->
                            <ColumnDefinition Width="Auto"/> <!-- Botón Dirección Orden -->
                            <ColumnDefinition Width="Auto"/> <!-- Switcher de Modo de Vista -->
                        </Grid.ColumnDefinitions>

                        <!-- Buscador con Lupa Integrada -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <TextBox x:Name="TxtSearchFilter" Style="{StaticResource ModernTextBoxStyle}" 
                                     Padding="32,7,28,7"
                                     TextChanged="TxtSearchFilter_TextChanged"/>

                            <!-- Icono de Lupa -->
                            <Path Data="{StaticResource IconSearchGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" Opacity="0.8"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>

                            <!-- Placeholder cuando está vacío -->
                            <TextBlock Text="Buscar héroe por nombre, clase, raza, rasgo o archivo (Ctrl+F)..." 
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="34,0,28,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchFilter}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Botón limpiar búsqueda -->
                            <Button x:Name="BtnClearSearch" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                    Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="BtnClearSearch_Click" Visibility="Collapsed" ToolTip="Limpiar búsqueda (Esc)">
                                <Border Background="#1E293B" CornerRadius="9" Width="18" Height="18">
                                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                          Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </Grid>

                        <!-- Filtro por Rol (Todos / Lords / Héroes) -->
                        <ComboBox x:Name="CbRoleFilter" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" 
                                  Width="136" Margin="0,0,10,0" SelectionChanged="CbRoleFilter_SelectionChanged"
                                  ToolTip="Filtrar personajes por rango (Lords vs Héroes)">
                            <ComboBoxItem Content="Todos los rangos" IsSelected="True"/>
                            <ComboBoxItem Content="👑 Solo Lords"/>
                            <ComboBoxItem Content="🛡️ Solo Héroes"/>
                        </ComboBox>

                        <!-- Selector de Ordenamiento -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock Text="ORDEN:" VerticalAlignment="Center" FontWeight="Bold" FontSize="10.5" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CbSortSelector" Style="{StaticResource ModernComboBoxStyle}" 
                                      Width="122" SelectionChanged="CbSortSelector_SelectionChanged"
                                      ToolTip="Ordenar personajes por atributo">
                                <ComboBoxItem Content="Nombre" Tag="DisplayName" IsSelected="True"/>
                                <ComboBoxItem Content="Nivel" Tag="Level"/>
                                <ComboBoxItem Content="Raza" Tag="RaceDisplay"/>
                                <ComboBoxItem Content="Clase" Tag="HeroClassDisplay"/>
                                <ComboBoxItem Content="Modificado" Tag="LastModified"/>
                                <ComboBoxItem Content="Tamaño" Tag="FileSizeBytes"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Botón Dirección de Orden (Asc/Desc) -->
                        <Button x:Name="BtnSortDirection" Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="8,6" Margin="0,0,10,0" Click="BtnSortDirection_Click" 
                                ToolTip="Alternar dirección: Ascendente / Descendente">
                            <Path x:Name="SortDirectionIcon" Data="{StaticResource IconSortAscGeometry}" 
                                  Fill="{StaticResource CyanNeonBrush}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <!-- Switcher de Modo de Vista [ Tabla | Galería ] -->
                        <Border Grid.Column="4" Background="#0A0F1A" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="7" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbViewTable" Style="{StaticResource ViewToggleButtonStyle}" 
                                             GroupName="ViewMode" IsChecked="True" Click="ViewToggle_Click" ToolTip="Vista Tabla detallada">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTableGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tabla" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbViewGallery" Style="{StaticResource ViewToggleButtonStyle}" 
                                             GroupName="ViewMode" Click="ViewToggle_Click" ToolTip="Vista Galería de tarjetas de héroes">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGalleryGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Galería" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 1: Chips Horizontales de Filtro por Raza con Escudos Oficiales -->
                    <Border Grid.Row="1" Margin="0,8,0,0" Padding="0,8,0,0" 
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanLightBrush}" 
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="FACCIONES:" FontWeight="Bold" FontSize="10.5" 
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Chips deslizables horizontalmente -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="IcRaceFilterChips">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="RaceChip_Click" Margin="0,0,6,0" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#0D1422"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Padding" Value="9,4"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" Background="{TemplateBinding Background}" 
                                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                                            CornerRadius="14" Padding="{TemplateBinding Padding}" 
                                                                            SnapsToDevicePixels="True">
                                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource CyanLightBrush}"/>
                                                                            <Setter TargetName="b" Property="Background" Value="#16253C"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#122B4A"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Icono de escudo de raza si existe -->
                                                    <Image Source="{Binding IconPath}" Width="16" Height="16" Margin="0,0,6,0" 
                                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <!-- Nombre de raza -->
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Badge con conteo de personajes -->
                                                    <Border Margin="6,0,0,0" CornerRadius="8" Padding="5,1" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#172235"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource CyanNeonBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Count}" FontSize="9.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource CyanLightBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="#0A0D14"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Indicador de filtro / conteo -->
                            <TextBlock x:Name="TxtFilterStatus" Grid.Column="2" VerticalAlignment="Center" 
                                       Foreground="{StaticResource CyanLightBrush}" FontWeight="Bold" FontSize="11" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. LISTA / GALERÍA DE PERSONAJES E INSPECTOR LATERAL RPG -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Área Principal: Tabla o Galería -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <!-- Vista 1: Tabla ListView -->
                    <ListView x:Name="LvCharacters" 
                              Style="{StaticResource ModernListViewStyle}"
                              SelectionChanged="LvCharacters_SelectionChanged"
                              MouseDoubleClick="LvCharacters_MouseDoubleClick"
                              GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ModernGridViewColumnHeaderStyle}"/>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Margin" Value="3,2,3,2"/>
                                <Setter Property="Padding" Value="6,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="ContextMenu" Value="{StaticResource CharacterContextMenu}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewMouseRightButtonDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <GridViewRowPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#26354D"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#10253F"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <!-- Columna: Personaje -->
                                <GridViewColumn x:Name="ColHeaderPersonaje" Header="PERSONAJE" Width="225">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Marco de retrato con borde Dorado para Lords o Cian para Héroes -->
                                                <Border Width="36" Height="36" CornerRadius="7" Background="#121E30" 
                                                        BorderThickness="1.2" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLord}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanLightBrush}" 
                                                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding PortraitImagePath}" Stretch="UniformToFill" 
                                                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" 
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <!-- Etiqueta guardada si existe -->
                                                        <TextBlock Text="{Binding SavedTagBadge}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource CyanLightBrush}" Margin="0,0,6,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSavedTag}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding FileName}" FontSize="9.5" 
                                                                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Clase + Badge Lord/Héroe -->
                                <GridViewColumn x:Name="ColHeaderClase" Header="CLASE / RANGO" Width="195">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Pill Rango (LORD en Oro / HÉROE en Cian) -->
                                                <Border CornerRadius="4" Padding="5,1.5" Margin="0,0,7,0" VerticalAlignment="Center" BorderThickness="0.8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#0E2238"/>
                                                            <Setter Property="BorderBrush" Value="#0284C7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLord}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource GoldDarkBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconCrownGeometry}" Fill="{StaticResource GoldLightBrush}" 
                                                              Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLord}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{Binding RoleShortDisplay}" FontSize="8.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource CyanLightBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLord}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="{Binding HeroClassDisplay}" FontSize="12" FontWeight="SemiBold" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" 
                                                           TextTrimming="CharacterEllipsis" MaxWidth="128"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Raza -->
                                <GridViewColumn x:Name="ColHeaderRaza" Header="FACCIÓN / RAZA" Width="135">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#111A29" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                                    BorderThickness="1" CornerRadius="5" Padding="6,2.5" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{Binding RaceIconPath}" Width="16" Height="16" Margin="0,0,5,0" 
                                                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RaceDisplay}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Nivel -->
                                <GridViewColumn x:Name="ColHeaderNivel" Header="NIVEL" Width="68">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#10281E" BorderBrush="#059669" 
                                                    BorderThickness="1" CornerRadius="5" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding LevelDisplay}" FontSize="11" FontWeight="Bold" 
                                                           Foreground="#34D399"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Rasgo -->
                                <GridViewColumn x:Name="ColHeaderRasgo" Header="RASGO INNATO" Width="135">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TraitDisplay}" FontSize="11" 
                                                       Foreground="{StaticResource CyanLightBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Tamaño -->
                                <GridViewColumn x:Name="ColHeaderTamano" Header="TAMAÑO" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedFileSize}" FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Columna: Modificado -->
                                <GridViewColumn x:Name="ColHeaderModificado" Header="MODIFICADO" Width="118">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedLastModified}" FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Vista 2: Galería de Tarjetas Visuales (Roster Cards) -->
                    <ListBox x:Name="LbGallery" 
                             Style="{StaticResource ModernListBoxStyle}"
                             SelectionChanged="LbGallery_SelectionChanged"
                             MouseDoubleClick="LbGallery_MouseDoubleClick"
                             Visibility="Collapsed">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ContextMenu" Value="{StaticResource CharacterContextMenu}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewMouseRightButtonDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="cardBorder" 
                                                    Width="198" Height="266"
                                                    Background="{StaticResource SurfaceCardBrush}" 
                                                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                                                    BorderThickness="1.2" 
                                                    CornerRadius="10" 
                                                    SnapsToDevicePixels="True"
                                                    ClipToBounds="True"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="cardScale" ScaleX="1.0" ScaleY="1.0"/>
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="cardShadow" ShadowDepth="3" BlurRadius="10" Opacity="0.35" Color="#000000"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="2.5"/> <!-- Barra superior de rango (Oro/Cian) -->
                                                        <RowDefinition Height="142"/> <!-- Imagen de Retrato -->
                                                        <RowDefinition Height="*"/>   <!-- Datos del Personaje -->
                                                    </Grid.RowDefinitions>

                                                    <!-- 0. BARRA DE ACENTO DE RANGO -->
                                                    <Border Grid.Row="0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLord}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource GoldGradientBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <!-- 1. ZONA RETRATO -->
                                                    <Border Grid.Row="1" Background="#0A101B" ClipToBounds="True">
                                                        <Grid>
                                                            <!-- Placeholder de fondo si no hay retrato -->
                                                            <Path Data="{StaticResource IconHeroGeometry}" Fill="#1A2D45" 
                                                                  Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                            <!-- Retrato oficial -->
                                                            <Image Source="{Binding PortraitImagePath}" Stretch="UniformToFill" 
                                                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                            <!-- Viñeta inferior degradada para legibilidad -->
                                                            <Border VerticalAlignment="Bottom" Height="48">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#000A101B" Offset="0"/>
                                                                        <GradientStop Color="#F2131824" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <!-- Badge de Raza (Arriba Izquierda) -->
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                                    Margin="7" CornerRadius="5" Padding="5,2.5"
                                                                    Background="#E00B111C" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0.8">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Image Source="{Binding RaceIconPath}" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <TextBlock Text="{Binding RaceDisplay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Badge de Nivel (Arriba Derecha) -->
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                                    Margin="7" CornerRadius="5" Padding="6,2.5"
                                                                    Background="#E60F241B" BorderBrush="#059669" BorderThickness="0.8">
                                                                <TextBlock Text="{Binding LevelDisplay}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                            </Border>

                                                            <!-- Badge de Rango LORD / HÉROE (Abajo Izquierda sobre el retrato) -->
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                    Margin="8,0,0,6" CornerRadius="4" Padding="5,1.5" BorderThickness="0.8">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#D90B1E33"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLord}" Value="True">
                                                                                <Setter Property="Background" Value="#E6261907"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource GoldPrimaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource IconCrownGeometry}" Fill="{StaticResource GoldLightBrush}"
                                                                          Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLord}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                    <TextBlock Text="{Binding RoleShortDisplay}" FontSize="8.5" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource CyanLightBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLord}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 2. ZONA DATOS -->
                                                    <Grid Grid.Row="2" Margin="10,7,10,9">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Nombre Principal -->
                                                        <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13.5" 
                                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                        <!-- Clase de héroe -->
                                                        <TextBlock Grid.Row="1" Text="{Binding HeroClassDisplay}" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="{StaticResource CyanNeonBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                                                        <!-- Pie de tarjeta: Rasgo innato + Etiqueta -->
                                                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" HorizontalAlignment="Left" Background="#0C1422" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                                                    BorderThickness="0.8" CornerRadius="4" Padding="6,2.5">
                                                                <TextBlock Text="{Binding TraitDisplay}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" 
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="115"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1" Text="{Binding SavedTagBadge}" FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                                       MaxWidth="55" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource CyanLightBrush}"/>
                                                    <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                                                    <Setter TargetName="cardBorder" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="cardBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.4" Color="#00D2FF"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource CyanNeonBrush}"/>
                                                    <Setter TargetName="cardBorder" Property="BorderThickness" Value="1.8"/>
                                                    <Setter TargetName="cardBorder" Property="Background" Value="#10253F"/>
                                                    <Setter TargetName="cardBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="2" BlurRadius="18" Opacity="0.6" Color="#00D2FF"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Estado vacío (Empty State) -->
                    <Border x:Name="EmptyStateOverlay" Background="{StaticResource SurfaceCardBrush}" 
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                            CornerRadius="10" Visibility="Collapsed" Padding="30">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="68" Height="68" CornerRadius="34" Background="#0F1B2D" 
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1.2"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanLightBrush}" Opacity="0.5"
                                      Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No se encontraron personajes" FontSize="17" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Ajusta los filtros de búsqueda o pulsa 'Escanear' para recargar tu cuartel." 
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Panel Lateral Derecho: Inspector de Personaje RPG + Dock de Acciones -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Ficha / Inspector del Personaje -->
                            <RowDefinition Height="Auto"/> <!-- Dock de Acciones Fijo Inferior -->
                        </Grid.RowDefinitions>

                        <!-- ZONA 1: FICHA DEL PERSONAJE -->
                        <Grid Grid.Row="0">
                            <!-- Estado CON personaje seleccionado -->
                            <Grid x:Name="CardSelectedInfo" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Banner Heroico Superior -->
                                    <RowDefinition Height="Auto"/> <!-- Grilla 2x2 de Atributos -->
                                    <RowDefinition Height="*"/>    <!-- Habilidades (Scrollable) -->
                                </Grid.RowDefinitions>

                                <!-- 1.1 Banner Heroico con Marca de Agua de Facción -->
                                <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,14,14,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#142238" Offset="0.0"/>
                                            <GradientStop Color="#0D131F" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <!-- Escudo de Facción Gigante Difuminado como Marca de Agua -->
                                        <Image x:Name="ImgSelectedBannerWatermark" Width="110" Height="110" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-10,-10,-10"
                                               Opacity="0.10" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Marco del Retrato Estilo Porthole -->
                                            <Border x:Name="BorderSelectedPortraitFrame" Grid.Column="0" Width="68" Height="68" CornerRadius="10" 
                                                    Background="#0C1524" BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="1.6"
                                                    Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00D2FF" Opacity="0.35"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanLightBrush}" 
                                                          Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image x:Name="ImgSelectedPortrait" Stretch="UniformToFill" 
                                                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Nombre, Rango, Nivel y Etiqueta -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- Badges superiores: Rango (LORD/HÉROE) + Nivel -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <Border x:Name="BorderSelectedRoleBadge" Background="#0E2238" BorderBrush="#0284C7" 
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path x:Name="IconSelectedRoleCrown" Data="{StaticResource IconCrownGeometry}" 
                                                                  Fill="{StaticResource GoldLightBrush}" Width="9" Height="9" Stretch="Uniform" 
                                                                  Margin="0,0,4,0" Visibility="Collapsed"/>
                                                            <TextBlock x:Name="TxtSelectedRoleBadge" Text="HÉROE" FontSize="9" FontWeight="Bold" 
                                                                       Foreground="{StaticResource CyanLightBrush}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#10281E" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,1.5">
                                                        <TextBlock x:Name="TxtSelectedLevel" Text="Nv. 1" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Nombre del Personaje -->
                                                <TextBlock x:Name="TxtSelectedName" Text="Nombre del Héroe" FontSize="15.5" FontWeight="Bold" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>

                                                <!-- Etiqueta de Guardado -->
                                                <TextBlock x:Name="TxtSelectedSavedTag" Text="Etiqueta: -" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource CyanLightBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 1.2 Grilla de Atributos RPG (2x2 Cards) -->
                                <Grid Grid.Row="1" Margin="12,10,12,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Caja 1: Clase -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceInputBrush}" 
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="6" Padding="8,6" Margin="0,0,4,6">
                                        <StackPanel>
                                            <TextBlock Text="CLASE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtSelectedClass" Text="-" FontSize="11.5" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource CyanNeonBrush}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Caja 2: Raza / Facción -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceInputBrush}" 
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="6" Padding="8,6" Margin="4,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="FACCIÓN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image x:Name="ImgSelectedRace" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="TxtSelectedRace" Text="-" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Caja 3: Rasgo Innato -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceInputBrush}" 
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="RASGO INNATO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtSelectedTrait" Text="-" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Caja 4: Archivo en Disco -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceInputBrush}" 
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="6" Padding="8,5" Margin="4,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="ARCHIVO .TWC" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="TxtSelectedFileName" Text="-" FontSize="10" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </StackPanel>
                                            <Button x:Name="BtnOpenFileLocation" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                                    Padding="6,4" Margin="4,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="Localizar archivo .twc en el Explorador de Windows" Click="BtnOpenFileLocation_Click">
                                                <Path Data="{StaticResource IconFolderGeometry}" Fill="{StaticResource CyanLightBrush}" Width="11" Height="11" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 1.3 Habilidades Aprendidas (Con Scroll Independiente) -->
                                <Grid Grid.Row="2" Margin="12,4,12,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6">
                                        <Path Data="{StaticResource IconSparkleGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                                              Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSkillsHeader" Text="HABILIDADES APRENDIDAS" FontSize="10" FontWeight="Bold" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0C111C" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                            BorderThickness="1" CornerRadius="7" Padding="8,7">
                                        <Grid>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="IcSelectedSkills" Visibility="Collapsed">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#112238" BorderBrush="#1E3A5F" BorderThickness="1" 
                                                                    CornerRadius="5" Padding="7,3" Margin="0,0,5,5">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Ellipse Width="4" Height="4" Fill="{StaticResource CyanNeonBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource CyanLightBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock x:Name="TxtNoSkills" Text="Habilidades base de campaña (sin puntos adicionales registrados)" 
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" 
                                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       TextAlignment="Center" Margin="10" Visibility="Visible"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Estado SIN selección -->
                            <StackPanel x:Name="CardNoSelection" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#0E1726" 
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource TextMutedBrush}" 
                                          Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Ningún héroe seleccionado" FontSize="14" FontWeight="Bold" 
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Selecciona un personaje en la tabla o galería para inspeccionar su ficha completa, habilidades y acciones." 
                                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- ZONA 2: DOCK DE ACCIONES COMPACTO ANCLADO AL FONDO -->
                        <Border Grid.Row="1" Background="#0D121D" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <!-- Acción Principal: Duplicar -->
                                <Button x:Name="BtnDuplicateCharacter" Style="{StaticResource PrimaryButtonStyle}" 
                                        Height="40" Margin="0,0,0,8" Click="BtnDuplicateCharacter_Click"
                                        IsEnabled="False" ToolTip="Generar múltiples copias funcionales de este personaje (Enter / Doble Clic)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCopyGeometry}" Fill="White" 
                                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="DUPLICAR PERSONAJE..." FontWeight="Bold" FontSize="12.5"/>
                                    </StackPanel>
                                </Button>

                                <!-- Fila de Acciones Secundarias: Editar | Exportar | Eliminar -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Botón Editar -->
                                    <Button x:Name="BtnEditCharacter" Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="34" Padding="8,4" Margin="0,0,4,0" Click="BtnEditCharacter_Click"
                                            IsEnabled="False" ToolTip="Modificar nombre, apellido y etiqueta in-game (Ctrl+E)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconEditGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Editar" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Botón Exportar -->
                                    <Button x:Name="BtnExportCharacter" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="34" Padding="8,4" Margin="4,0,4,0" Click="BtnExportCharacter_Click"
                                            IsEnabled="False" ToolTip="Exportar una copia del archivo .twc a otra ubicación">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconExportGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Exportar" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Botón Eliminar -->
                                    <Button x:Name="BtnDeleteCharacter" Grid.Column="2" Style="{StaticResource DangerButtonStyle}" 
                                            Height="34" Padding="10,4" Margin="4,0,0,0" Click="BtnDeleteCharacter_Click"
                                            IsEnabled="False" ToolTip="Eliminar este archivo de personaje del disco (Supr)">
                                        <Path Data="{StaticResource IconDeleteGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. BARRA DE ESTADO INFERIOR -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceCardBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                    CornerRadius="8" Padding="14,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource CyanNeonBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Listo" FontWeight="SemiBold" FontSize="11.5" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Doble clic: Duplicar  •  Ctrl+E: Editar  •  F5: Escanear" FontSize="10.5" 
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="WH3 Character Manager" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyanLightBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- OVERLAY OSCURO PARA VENTANAS MODALES -->
        <Border x:Name="ModalBackdrop" Grid.Row="0" Grid.RowSpan="2" 
                Background="#A605080F" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- BANNER DE NOTIFICACIÓN FLOTANTE (TOAST) -->
        <Border x:Name="ToastNotification" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                Margin="0,0,0,24" Padding="16,10" CornerRadius="8"
                Background="#10253F" BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="1.2"
                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Color="#00D2FF" Opacity="0.45" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="ToastIcon" Data="{StaticResource IconCheckGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtToastMessage" Text="Acción realizada con éxito" FontWeight="SemiBold" FontSize="12.5" 
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
