<Window x:Class="WH3CharacterManager.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicar Personaje - Warhammer 3" Height="730" Width="540"
        MinHeight="540" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None"
        Background="{StaticResource AppBgBrush}"
        BorderBrush="{StaticResource BorderSubtleBrush}"
        BorderThickness="1"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra de Título -->
            <RowDefinition Height="*"/>    <!-- Cuerpo Principal con Footer -->
        </Grid.RowDefinitions>

        <!-- Barra de Título Personalizada -->
        <Grid Grid.Row="0" Height="36" Background="#0A0D14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Path Data="{StaticResource IconCopyGeometry}" Fill="{StaticResource CyanNeonBrush}" 
                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="DUPLICAR PERSONAJE" FontSize="11" FontWeight="Bold" 
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource TitleBarCloseButtonStyle}" 
                    Click="BtnCancel_Click" ToolTip="Cerrar" WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="{StaticResource IconCloseGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                      Width="10" Height="10" Stretch="Uniform"/>
            </Button>
        </Grid>

        <!-- Contenedor Principal de la Ventana -->
        <Border Grid.Row="1" Margin="14,2,14,14" Background="{StaticResource SurfaceCardBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.5"/>  <!-- Barra luminosa superior -->
                    <RowDefinition Height="*"/>    <!-- Contenido Scrollable -->
                    <RowDefinition Height="Auto"/> <!-- Footer Fijo Anclado -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource HeaderGlowGradient}"/>

                <!-- Zona de Contenido Scrollable -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="16,14,16,8">
                    <StackPanel>
                        <!-- 1. Encabezado -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="GENERADOR DE COPIAS FUNCIONALES" FontWeight="Bold" FontSize="14" 
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Genera copias con identificadores únicos compatibles con Warhammer 3" 
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 2. Información del personaje seleccionado con Retrato -->
                        <Border Margin="0,0,0,8" Background="{StaticResource SurfaceInputBrush}" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Marco de Retrato -->
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="6" Background="#142338" 
                                        BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="1" Margin="0,0,10,0"
                                        ClipToBounds="True" VerticalAlignment="Center">
                                    <Grid>
                                        <Path Data="{StaticResource IconHeroGeometry}" Fill="{StaticResource CyanLightBrush}" 
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="ImgCharacterPortrait" Stretch="UniformToFill" 
                                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PERSONAJE BASE:" FontSize="9" FontWeight="Bold" 
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="LblCharacterName" FontSize="13.5" FontWeight="Bold" 
                                               Foreground="{StaticResource CyanNeonBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="LblCharacterSubInfo" FontSize="10.5" 
                                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. Opciones de duplicación y Stepper -->
                        <Border Margin="0,0,0,8" Background="{StaticResource SurfaceInputBrush}" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="NÚMERO DE COPIAS A GENERAR" FontSize="10.5" FontWeight="Bold" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Botón Restar -->
                                    <Button x:Name="BtnMinusCopies" Grid.Column="0" Content="-" Width="30" Height="30" 
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="0" FontSize="15" 
                                            Click="BtnMinusCopies_Click" ToolTip="Restar 1"/>

                                    <!-- Input Cantidad -->
                                    <TextBox x:Name="TxtCopies" Grid.Column="1" Text="10" 
                                             Style="{StaticResource ModernTextBoxStyle}" 
                                             TextAlignment="Center" FontWeight="Bold" FontSize="13" 
                                             Margin="6,0" TextChanged="TxtCopies_TextChanged"/>

                                    <!-- Botón Sumar -->
                                    <Button x:Name="BtnPlusCopies" Grid.Column="2" Content="+" Width="30" Height="30" 
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="0" FontSize="15" 
                                            Click="BtnPlusCopies_Click" ToolTip="Sumar 1"/>

                                    <!-- Presets rápidos -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="+1" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" FontSize="10.5" Margin="2,0" Click="BtnPreset_Click"/>
                                        <Button Content="+5" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" FontSize="10.5" Margin="2,0" Click="BtnPreset_Click"/>
                                        <Button Content="+10" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" FontSize="10.5" Margin="2,0" Click="BtnPreset_Click"/>
                                        <Button Content="+25" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" FontSize="10.5" Margin="2,0" Click="BtnPreset_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Personalización Avanzada de Nombres -->
                        <Border Margin="0,0,0,8" Background="{StaticResource SurfaceInputBrush}" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="ChkDifferentiateCopies" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" 
                                          Checked="ChkDifferentiateCopies_Changed" Unchecked="ChkDifferentiateCopies_Changed">
                                    <TextBlock Text="Diferenciar nombres de las copias (in-game)" FontWeight="Bold" FontSize="11" 
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,0"/>
                                </CheckBox>

                                <StackPanel x:Name="PanelNamingPatterns" Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Patrón de nombre:" FontSize="10.5" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtNamePattern" Grid.Column="1" Text="{}{name} ({n})" 
                                                 Style="{StaticResource ModernTextBoxStyle}" TextChanged="TxtPattern_TextChanged"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Patrón de etiqueta:" FontSize="10.5" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtTagPattern" Grid.Column="1" Text="{}{tag}_{n}" 
                                                 Style="{StaticResource ModernTextBoxStyle}" TextChanged="TxtPattern_TextChanged"/>
                                    </Grid>
                                    <TextBlock Text="Variables: {name}=nombre base, {tag}=etiqueta base, {n}=número de copia." 
                                               FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 5. Vista previa de IDs generados y Nombres -->
                        <Border Margin="0,0,0,8" Background="#0C1420" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="VISTA PREVIA DE GENERACIÓN" FontSize="10" FontWeight="Bold" 
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,4"/>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Primera copia:" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="TxtPreviewFirst" Text="Calculando..." FontSize="10.5" 
                                                   Foreground="{StaticResource CyanLightBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtPreviewFirstName" Text="" FontSize="9.5" 
                                                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Última copia:" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="TxtPreviewLast" Text="Calculando..." FontSize="10.5" 
                                                   Foreground="{StaticResource CyanLightBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtPreviewLastName" Text="" FontSize="9.5" 
                                                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6. Opción de carpeta destino -->
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="UBICACIÓN DE DESTINO" FontSize="10.5" FontWeight="Bold" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <RadioButton x:Name="RbSameFolder" Content="Guardar en la misma carpeta original" 
                                         IsChecked="True" Style="{StaticResource ModernRadioButtonStyle}"/>
                            <RadioButton x:Name="RbCustomFolder" Content="Seleccionar otra carpeta de destino..." 
                                         Style="{StaticResource ModernRadioButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Fijo Anclado -->
                <Border Grid.Row="2" Background="#0C101A" BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="0,1,0,0" CornerRadius="0,0,9,9" Padding="16,10,16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barra de progreso y estado -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtProgressStatus" Text="" HorizontalAlignment="Center" Margin="0,0,0,4"
                                       Foreground="{StaticResource CyanLightBrush}" FontWeight="SemiBold" FontSize="11" Visibility="Collapsed"/>
                            <ProgressBar x:Name="PbProgress" Style="{StaticResource ModernProgressBarStyle}" Height="8" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Botones de acción -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnCancel" Grid.Column="1" Content="CANCELAR" Width="110" Height="36" 
                                    Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>

                            <Button x:Name="BtnDuplicate" Grid.Column="2" Width="140" Height="36" 
                                    Style="{StaticResource PrimaryButtonStyle}" Click="BtnDuplicate_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCopyGeometry}" Fill="White" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DUPLICAR" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
